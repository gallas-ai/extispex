{
  "license": "AGPL-3.0-only",
  "workspace": [
    "packages/contracts",
    "packages/service-client",
    "packages/service-runtime",
    "packages/telemetry-ids",
    "packages/service-storage",
    "services/telemetry",
    "services/prompt",
    "services/identity",
    "services/evaluation",
    "services/gateway",
    "apps/all-in-one",
    "apps/web",
    "tests/e2e",
    "tests/architecture",
    "tests/performance",
    "examples/typescript"
  ],
  "nodeModulesDir": "auto",
  "allowScripts": {
    "deny": ["npm:protobufjs"]
  },
  "compilerOptions": {
    "strict": true
  },
  "fmt": {
    "lineWidth": 100,
    "exclude": [
      "**/dist/",
      "**/otlp-proto/",
      "**/generated/",
      "data/",
      "docs/business.md"
    ]
  },
  "lint": {
    "exclude": [
      "**/dist/",
      "**/generated/",
      "data/"
    ],
    "plugins": [
      "./tests/architecture/descriptive-names-lint-plugin.ts"
    ],
    "rules": {
      "tags": [
        "recommended"
      ]
    }
  },
  "tasks": {
    "start:all-in-one": "deno task --cwd apps/all-in-one start",
    "build:web": "deno task --cwd apps/web build",
    "dev:web": "deno task --cwd apps/web dev",
    "generate:otlp-descriptor": "deno task --cwd services/telemetry generate:otlp-descriptor",
    "check": "deno fmt --check && deno lint && deno check && deno task test:architecture",
    "test": "deno test --allow-read --allow-write --allow-env --allow-ffi --allow-sys --allow-net --allow-run --ignore=tests/e2e,tests/architecture",
    "test:architecture": "deno test --allow-read tests/architecture",
    "test:e2e": "deno test --allow-all tests/e2e",
    "test:performance": "deno run --allow-all tests/performance/measure-performance.ts",
    "compare:performance": "deno run --allow-read --allow-env --allow-write tests/performance/compare-performance.ts",
    "install:browser": "deno run --allow-all npm:playwright-core@1.64.1 install chromium"
  },
  "exclude": [
    "**/dist/",
    "data/"
  ]
}
