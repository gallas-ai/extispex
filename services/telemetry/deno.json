{
  "name": "@extispex/telemetry-service",
  "version": "0.1.0",
  "exports": {
    ".": "./src/create-service.ts"
  },
  "imports": {
    "@grpc/grpc-js": "npm:@grpc/grpc-js@^1.14.0",
    "@hono/zod-openapi": "npm:@hono/zod-openapi@^1.1.0",
    "@mikro-orm/core": "npm:@mikro-orm/core@7.2.7",
    "@mikro-orm/migrations": "npm:@mikro-orm/migrations@7.2.7",
    "@mikro-orm/sql": "npm:@mikro-orm/sql@7.2.7",
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "hono": "npm:hono@^4.10.0",
    "protobufjs": "npm:protobufjs@^7.5.0",
    "zod": "npm:zod@^4.1.0"
  },
  "tasks": {
    "start": "deno run --allow-net --allow-env --allow-read --allow-write --allow-ffi --allow-sys src/main.ts",
    "generate:otlp-descriptor": "deno run --allow-read --allow-write scripts/generate-otlp-descriptor.ts"
  }
}
