{
  "name": "@extispex/web",
  "version": "0.1.0",
  "exports": {
    ".": "./src/main.tsx"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "@types/react": "npm:@types/react@^19.0.0",
    "@types/react-dom": "npm:@types/react-dom@^19.0.0",
    "@vitejs/plugin-react": "npm:@vitejs/plugin-react@^5.0.0",
    "echarts": "npm:echarts@6.1.0",
    "echarts/": "npm:/echarts@6.1.0/",
    "react": "npm:react@^19.0.0",
    "react-dom": "npm:react-dom@^19.0.0",
    "react-router": "npm:react-router@8.5.1",
    "vite": "npm:vite@^7.0.0"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "jsxImportSourceTypes": "@types/react",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ]
  },
  "tasks": {
    "dev": "deno run --allow-all npm:vite",
    "build": "deno run --allow-all npm:vite build"
  }
}
